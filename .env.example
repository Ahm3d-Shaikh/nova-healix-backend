# Free key from https://api.nasa.gov (blank or DEMO_KEY = heavily rate-limited)
NASA_API_KEY=DEMO_KEY
# JSON list of allowed browser origins (Angular dev server by default)
CORS_ORIGINS=["http://localhost:4200"]
LOG_LEVEL=INFO
# Where Mirror Gap / isolation results are saved (JSON). Leave empty to keep them in memory only.
SUBMISSIONS_DIR=var
