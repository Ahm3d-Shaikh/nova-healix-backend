# --- NASA (free key from https://api.nasa.gov; blank or DEMO_KEY = heavily rate-limited) ---
NASA_API_KEY=DEMO_KEY

# --- Web ---
# JSON list of allowed browser origins: the Angular dev server and the deployed frontend (e.g. the Vercel URL).
CORS_ORIGINS=["http://localhost:4200","https://nova-helix.vercel.app"]
LOG_LEVEL=INFO

# --- Supabase (Project Settings -> API). Blank = in-memory store, data lost on restart. ---
# Use the service_role key (server-side only, never ship it to the frontend).
# Run supabase/schema.sql in the SQL editor first (it keeps the RIDGE tables and adds the v2 ones).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (free key: https://aistudio.google.com/apikey) ---
# One key serves two things:
#   * ECHO, the scored isolation check-in chat (/api/isolation/*). Blank = those calls return 503.
#   * Nova, the private companion (/api/crew/{id}/companion/reply): Gemini writes only the open-ended replies.
#     Blank = Nova answers from its deterministic rules. Safety messages are always pre-written, never generated.
GEMINI_API_KEY=
# ECHO: scores each finished check-in (one call per check-in; quality matters).
GEMINI_MODEL=gemini-3.8-flash
# ECHO chat replies and Nova's open-ended replies (speed matters). ECHO falls back to GEMINI_MODEL if this one fails.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_TIMEOUT_SECONDS=20
# true/false: switch Nova off entirely (its reply endpoint then returns 503)
COMPANION_ENABLED=true

# --- Mission clock (optional) ---
# Epoch ms of mission hour 0. Blank = anchored so "now" is mission day 142 and saved in the database.
LAUNCH_EPOCH_MS=
