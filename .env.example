# --- NASA (free key from https://api.nasa.gov; blank or DEMO_KEY = heavily rate-limited) ---
NASA_API_KEY=DEMO_KEY

# --- Web ---
# JSON list of allowed browser origins: the Angular dev server and the deployed frontend (e.g. the Vercel URL).
CORS_ORIGINS=["http://localhost:4200"]
LOG_LEVEL=INFO

# --- Supabase (Project Settings -> API). Blank = in-memory store, data lost on restart. ---
# Use the service_role key (server-side only, never ship it to the frontend).
# Run supabase/schema.sql in the SQL editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Nova (private companion) ---
# Blank = Nova answers with its deterministic rules only (safety, check-ins, shares, topics).
# With a key (free: https://aistudio.google.com/apikey) Gemini writes the open-ended replies.
# Safety messages are always pre-written, never generated.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_TIMEOUT_SECONDS=20
# true/false: switch Nova off entirely (the reply endpoint then returns 503)
COMPANION_ENABLED=true

# --- Mission clock (optional) ---
# Epoch ms of mission hour 0. Blank = anchored so "now" is mission day 142 and saved in the database.
LAUNCH_EPOCH_MS=
