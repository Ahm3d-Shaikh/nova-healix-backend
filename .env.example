# Free key from https://api.nasa.gov (blank or DEMO_KEY = heavily rate-limited)
NASA_API_KEY=DEMO_KEY
# JSON list of allowed browser origins (Angular dev server by default)
CORS_ORIGINS=["http://localhost:4200"]
LOG_LEVEL=INFO

# Supabase (Project Settings -> API). Blank = in-memory store, data lost on restart.
# Use the service_role key (server-side only, never ship it to the frontend).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API key for the AI isolation check-in companion (free key: https://aistudio.google.com/apikey).
# Blank = check-ins return HTTP 503; the rest of the dashboard still works.
GEMINI_API_KEY=
# Scores each finished check-in (one call per check-in; quality matters).
GEMINI_MODEL=gemini-3.8-flash
# Writes ECHO's chat replies (one call per message; speed matters). Falls back to GEMINI_MODEL
# if this model is rate-limited, failing, or slower than GEMINI_CHAT_TIMEOUT_SECONDS.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_TIMEOUT_SECONDS=20
